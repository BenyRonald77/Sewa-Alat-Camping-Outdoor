<%- include('../partials/header', { title: title }) %>
<div class="page-head">
  <div>
    <h1><%= mode === 'baru' ? 'Tambah Alat Baru' : 'Ubah Data Alat' %></h1>
    <p>Isi data alat dengan lengkap. Semua field wajib diisi.</p>
  </div>
</div>

<% if (errors && errors.length) { %>
  <div class="alert alert--error" role="alert">
    <strong>Data belum bisa disimpan:</strong>
    <ul>
      <% errors.forEach((e) => { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<div class="card" style="max-width: 640px;">
  <form method="post" action="<%= mode === 'baru' ? '/alat/baru' : '/alat/' + alat.id + '/ubah' %>" novalidate>
    <div class="form-grid">
      <div class="field">
        <label for="nama">Nama Alat</label>
        <input type="text" id="nama" name="nama" value="<%= alat.nama %>" required maxlength="100" placeholder="Contoh: Tenda Dome 4 Orang" />
      </div>

      <div class="field">
        <label for="kategori">Kategori</label>
        <select id="kategori" name="kategori" required>
          <option value="">Pilih kategori</option>
          <% kategoriPilihan.forEach((k) => { %>
            <option value="<%= k %>" <%= alat.kategori === k ? 'selected' : '' %>><%= k %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-grid form-grid--2col">
        <div class="field">
          <label for="stokTotal">Stok Total Unit</label>
          <input type="number" id="stokTotal" name="stokTotal" value="<%= alat.stokTotal %>" required min="0" step="1" inputmode="numeric" />
          <span class="field__hint">Jumlah unit fisik yang dimiliki toko.</span>
        </div>
        <div class="field">
          <label for="hargaSewaPerHari">Harga Sewa per Hari (Rp)</label>
          <input type="number" id="hargaSewaPerHari" name="hargaSewaPerHari" value="<%= alat.hargaSewaPerHari %>" required min="0" step="500" inputmode="numeric" />
        </div>
      </div>

      <div class="field">
        <label for="deposit">Nominal Deposit per Unit (Rp)</label>
        <input type="number" id="deposit" name="deposit" value="<%= alat.deposit %>" required min="0" step="500" inputmode="numeric" />
        <span class="field__hint">Dikembalikan penuh jika alat kembali dalam kondisi baik.</span>
      </div>
    </div>

    <div class="button-row">
      <button type="submit" class="button button--primary">Simpan</button>
      <a class="button button--secondary" href="/alat">Batal</a>
    </div>
  </form>
</div>
<%- include('../partials/footer') %>
