<!doctype html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' — Sewa Alat Outdoor' : 'Sewa Alat Outdoor' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <a class="skip-link" href="#konten-utama">Langsung ke konten utama</a>
  <header class="site-header">
    <div class="site-header__bar">
      <a class="brand" href="/">
        <span class="brand__mark" aria-hidden="true">&#9973;</span>
        <span class="brand__text">Sewa Alat Outdoor</span>
      </a>
      <button type="button" class="nav-toggle" id="navToggle" aria-expanded="false" aria-controls="navMenu">
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="nav-toggle__bar"></span>
        <span class="visually-hidden">Buka menu navigasi</span>
      </button>
    </div>
    <nav class="site-nav" id="navMenu">
      <a href="/" class="<%= path === '/' ? 'is-active' : '' %>">Dashboard</a>
      <a href="/alat" class="<%= path.startsWith('/alat') ? 'is-active' : '' %>">Inventaris Alat</a>
      <a href="/penyewaan" class="<%= path.startsWith('/penyewaan') ? 'is-active' : '' %>">Penyewaan</a>
      <a href="/pengembalian" class="<%= path.startsWith('/pengembalian') ? 'is-active' : '' %>">Pengembalian</a>
      <a href="/ketersediaan" class="<%= path.startsWith('/ketersediaan') ? 'is-active' : '' %>">Ketersediaan</a>
      <a href="/riwayat" class="<%= path.startsWith('/riwayat') ? 'is-active' : '' %>">Riwayat Transaksi</a>
    </nav>
  </header>
  <main id="konten-utama" class="page">
